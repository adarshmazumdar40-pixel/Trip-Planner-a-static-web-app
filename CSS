:root {
  --bg: #0b1020;
  --surface: rgba(17, 24, 39, 0.82);
  --surface-2: rgba(30, 41, 59, 0.72);
  --text: #e5e7eb;
  --muted: #94a3b8;
  --accent: #22d3ee;
  --accent-2: #a78bfa;
  --error: #f87171;
  --border: rgba(148, 163, 184, 0.2);
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: 'Manrope', system-ui, sans-serif;
  color: var(--text);
  background:
    radial-gradient(circle at top right, rgba(34, 211, 238, 0.15), transparent 35%),
    radial-gradient(circle at bottom left, rgba(167, 139, 250, 0.17), transparent 40%),
    var(--bg);
  min-height: 100vh;
}

.app-shell {
  width: min(1060px, 92vw);
  margin: 2.2rem auto 3rem;
  display: grid;
  gap: 1.2rem;
}

.hero h1 {
  margin: 0;
  font-size: clamp(1.8rem, 4vw, 2.8rem);
}

.eyebrow {
  margin: 0 0 0.25rem;
  color: var(--accent);
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  font-size: 0.78rem;
}

.subtitle {
  margin: 0.6rem 0 0;
  color: var(--muted);
  max-width: 640px;
}

.card {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 1.15rem;
  backdrop-filter: blur(10px);
}

.planner-form {
  display: grid;
  gap: 1rem;
}

.field-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 0.8rem;
}

label,
legend {
  font-size: 0.9rem;
  font-weight: 600;
  color: #d1d5db;
}

input,
select {
  width: 100%;
  margin-top: 0.4rem;
  padding: 0.72rem;
  border-radius: 10px;
  border: 1px solid rgba(148, 163, 184, 0.3);
  background: rgba(15, 23, 42, 0.8);
  color: var(--text);
  font: inherit;
}

input:focus,
select:focus,
.btn-primary:focus,
.day-tab:focus {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

.tags-block {
  margin: 0;
  padding: 0;
  border: none;
}

.tags-grid {
  margin-top: 0.55rem;
  display: flex;
  gap: 0.55rem;
  flex-wrap: wrap;
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  border: 1px solid var(--border);
  border-radius: 999px;
  padding: 0.4rem 0.7rem;
  background: rgba(30, 41, 59, 0.65);
  cursor: pointer;
}

.chip input {
  width: auto;
  margin: 0;
}

.form-error {
  margin: 0;
  color: var(--error);
  min-height: 1.2rem;
  font-size: 0.86rem;
}

.btn-primary {
  cursor: pointer;
  border: none;
  border-radius: 12px;
  color: #0f172a;
  font-weight: 800;
  font-size: 0.95rem;
  padding: 0.82rem 1rem;
  background: linear-gradient(120deg, var(--accent), var(--accent-2));
  transition: transform 0.2s ease, filter 0.2s ease;
}

.btn-primary:hover {
  transform: translateY(-1px);
  filter: brightness(1.03);
}

.results-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 0.8rem;
  flex-wrap: wrap;
}

.results h2 {
  margin: 0;
}

.trip-meta {
  margin: 0;
  color: var(--muted);
  font-size: 0.9rem;
}

.state {
  margin-top: 0.9rem;
  border: 1px dashed rgba(148, 163, 184, 0.35);
  border-radius: 14px;
  background: var(--surface-2);
  padding: 1.2rem;
  text-align: center;
}

.state h3 {
  margin-top: 0;
}

.state p {
  margin: 0;
  color: var(--muted);
}

.state-loading {
  display: grid;
  justify-items: center;
  gap: 0.8rem;
}

.pulse-dot {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: var(--accent);
  animation: pulse 1s infinite ease-in-out;
}

@keyframes pulse {
  0%,
  100% {
    transform: scale(0.9);
    opacity: 0.6;
  }
  50% {
    transform: scale(1.35);
    opacity: 1;
  }
}

.hidden {
  display: none;
}

.itinerary-wrap {
  margin-top: 1rem;
  display: grid;
  gap: 0.8rem;
}

.day-tabs {
  display: flex;
  gap: 0.45rem;
  overflow-x: auto;
  scrollbar-width: thin;
  padding-bottom: 0.2rem;
}

.day-tab {
  border: 1px solid var(--border);
  border-radius: 10px;
  background: rgba(15, 23, 42, 0.8);
  color: var(--text);
  font: inherit;
  font-weight: 700;
  font-size: 0.86rem;
  padding: 0.5rem 0.72rem;
  cursor: pointer;
  transition: background 0.2s ease, border-color 0.2s ease;
  white-space: nowrap;
}

.day-tab.active {
  background: linear-gradient(120deg, rgba(34, 211, 238, 0.25), rgba(167, 139, 250, 0.25));
  border-color: rgba(34, 211, 238, 0.5);
}

.day-panel {
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 1rem;
  background: rgba(15, 23, 42, 0.7);
  animation: fadeIn 0.32s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(6px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.slots {
  display: grid;
  gap: 0.62rem;
}

.slot {
  border: 1px solid rgba(148, 163, 184, 0.22);
  border-radius: 12px;
  padding: 0.78rem;
  background: rgba(30, 41, 59, 0.5);
}

.slot-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 0.8rem;
  margin-bottom: 0.25rem;
}

.slot h4,
.slot p {
  margin: 0;
}

.slot h4 {
  font-size: 0.95rem;
}

.slot p {
  color: var(--muted);
  font-size: 0.9rem;
}

.cost {
  font-size: 0.86rem;
  font-weight: 800;
  color: var(--accent);
}

@media (max-width: 900px) {
  .field-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 560px) {
  .app-shell {
    width: min(980px, 95vw);
    margin-top: 1rem;
  }

  .field-grid {
    grid-template-columns: 1fr;
  }

  .card {
    padding: 0.95rem;
  }

  .slot-head {
    align-items: flex-start;
    flex-direction: column;
    gap: 0.25rem;
  }
}
