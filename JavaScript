const fallbackInterests = ['Culture', 'Food', 'Nature'];
const slotLabels = ['Morning', 'Afternoon', 'Evening'];
const vibeProfiles = {
  Relaxed: {
    offsetBySlot: [0, 2, 4],
    twist: ['Slow-paced start', 'Leisure-first flow', 'Wind-down friendly']
  },
  Balanced: {
    offsetBySlot: [1, 3, 0],
    twist: ['Mix of exploration and downtime', 'Variety-packed rhythm', 'Good energy balance']
  },
  Packed: {
    offsetBySlot: [2, 4, 1],
    twist: ['High-energy sequencing', 'More activity density', 'Maximize city coverage']
  }
};

form.addEventListener('submit', (event) => {
  event.preventDefault();
  formError.textContent = '';

  const destination = document.getElementById('destination').value.trim();
  const startDate = document.getElementById('startDate').value;
  const endDate = document.getElementById('endDate').value;
  const vibe = document.getElementById('tripVibe').value;
  const selectedInterests = [...document.querySelectorAll('input[name="interests"]:checked')].map((tag) => tag.value);

  const validationError = validateInputs({ destination, startDate, endDate, vibe, selectedInterests });

  if (validationError) {
    formError.textContent = validationError;
    return;
  }

  const totalDays = getTotalDays(startDate, endDate);
  const activeInterests = selectedInterests.length ? selectedInterests : fallbackInterests;

  emptyState.classList.add('hidden');
  itineraryWrap.classList.add('hidden');
  loadingState.classList.remove('hidden');

  setTimeout(() => {
    const itinerary = buildItinerary({ destination, startDate, totalDays, vibe, interests: activeInterests });
    renderItinerary(itinerary, { destination, startDate, endDate, vibe, interests: activeInterests });
    loadingState.classList.add('hidden');
    itineraryWrap.classList.remove('hidden');
  }, 550);
});

function validateInputs({ destination, startDate, endDate, vibe, selectedInterests }) {
  if (!destination || !startDate || !endDate || !vibe) {
    return 'Please fill destination, date range, and vibe.';
  }

  if (new Date(endDate) < new Date(startDate)) {
    return 'End date must be on or after start date.';
  }

  if (getTotalDays(startDate, endDate) > 14) {
    return 'For demo clarity, keep trips to 14 days or less.';
  }

  if (selectedInterests.length === 0) {
    return 'Pick at least one interest tag to personalize the plan.';
  }

  return '';
}

function getTotalDays(startDate, endDate) {
  const start = new Date(startDate);
  const end = new Date(endDate);
  const diffTime = end.getTime() - start.getTime();
  return Math.floor(diffTime / (1000 * 60 * 60 * 24)) + 1;
}

function buildItinerary({ destination, startDate, totalDays, vibe, interests }) {
  const profile = vibeProfiles[vibe] || vibeProfiles.Balanced;

  return Array.from({ length: totalDays }, (_, dayIndex) => {
    const dateObj = new Date(startDate);
    dateObj.setDate(dateObj.getDate() + dayIndex);

    const slots = slotLabels.map((slot, slotIndex) => {
      const interest = interests[(dayIndex + slotIndex) % interests.length];
      const pool = venueBank[interest] || venueBank.Culture;
      const pickIndex = (dayIndex * 3 + profile.offsetBySlot[slotIndex]) % pool.length;
      const pickedVenue = pool[pickIndex];

      return {
        slot,
        interest,
        venueType: pickedVenue.type,
        costBand: pickedVenue.cost,
        note: `${pickedVenue.note} • ${profile.twist[slotIndex % profile.twist.length]}`
      };
    });

    return {
      dayLabel: `Day ${dayIndex + 1}`,
      dateLabel: dateObj.toLocaleDateString('en-IN', {
        weekday: 'short',
        day: 'numeric',
        month: 'short'
      }),
      destination,
      slots
    };
  });
}

function renderItinerary(days, meta) {
  dayTabs.innerHTML = '';
  dayPanels.innerHTML = '';

  tripMeta.textContent = `${meta.destination} • ${meta.vibe} vibe • ${days.length} day${days.length > 1 ? 's' : ''}`;

  days.forEach((day, index) => {
    const tab = document.createElement('button');
    tab.type = 'button';
    tab.className = `day-tab ${index === 0 ? 'active' : ''}`;
    tab.textContent = `${day.dayLabel}`;
    tab.setAttribute('role', 'tab');
    tab.setAttribute('aria-selected', index === 0 ? 'true' : 'false');
    tab.setAttribute('aria-controls', `panel-${index}`);
    tab.id = `tab-${index}`;

    const panel = document.createElement('article');
    panel.className = 'day-panel';
    panel.id = `panel-${index}`;
    panel.setAttribute('role', 'tabpanel');
    panel.setAttribute('aria-labelledby', `tab-${index}`);
    panel.hidden = index !== 0;

    panel.innerHTML = `
      <h3>${day.dayLabel} · ${day.dateLabel}</h3>
      <div class="slots">
        ${day.slots
          .map(
            (slot) => `
              <section class="slot">
                <div class="slot-head">
                  <h4>${slot.slot} · ${slot.interest}</h4>
                  <span class="cost">${slot.costBand}</span>
                </div>
                <p><strong>${slot.venueType}</strong></p>
                <p>${slot.note}</p>
              </section>
            `
          )
          .join('')}
      </div>
    `;

    tab.addEventListener('click', () => activateDay(index));

    dayTabs.appendChild(tab);
    dayPanels.appendChild(panel);
  });
}

function activateDay(activeIndex) {
  const tabs = [...dayTabs.querySelectorAll('.day-tab')];
  const panels = [...dayPanels.querySelectorAll('.day-panel')];

  tabs.forEach((tab, index) => {
    const isActive = index === activeIndex;
    tab.classList.toggle('active', isActive);
    tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
  });

  panels.forEach((panel, index) => {
    panel.hidden = index !== activeIndex;
  });
}
